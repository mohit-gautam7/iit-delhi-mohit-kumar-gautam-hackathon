# RiskPulse AI needs no API keys or secrets. All settings below are optional.

# Optional transformer mode (pip install -r requirements-transformers.txt)
RISKPULSE_FINBERT_MODEL=ProsusAI/finbert
RISKPULSE_ZERO_SHOT_MODEL=facebook/bart-large-mnli
# Set to 1 to use only locally cached Hugging Face weights (no network)
HF_HUB_OFFLINE=0
